# fullstack-from-scratch — macOS packages. `brew bundle` installs what is missing.

# version control
brew "git"
brew "gh"

# languages and managers
brew "fnm"
brew "pnpm"
brew "python@3.12"
brew "uv"

# search and shell
brew "ripgrep"
brew "fd"
brew "fzf"
brew "jq"
brew "bat"
brew "eza"
brew "tmux"
brew "wget"
brew "curl"

# media
brew "ffmpeg"

# apps (skipped with --no-apps)
cask "visual-studio-code"
cask "docker"
cask "obsidian"
cask "obs"
cask "anki"
